[
  {
    "kernelSource": {
      "name": "crux-marisa",
      "repo": "https://github.com/diudiuyc5200/0723.git",
      "branch": "ceshi",
      "device": "crux",
      "defconfig": "crux_defconfig"
    },
    "toolchains": [
      {
        "name": "zyc-clang",
        "url": "https://github.com/ZyCromerZ/Clang/releases/download/14.0.6-20260619-release/Clang-14.0.6-20260619.tar.gz",
        "binaryEnv": ["./bin"]
      }
    ],
    "enableCcache": true,
    "params": {
      "ARCH": "arm64",
      "CC": "zyc-clang/bin/clang",
      "externalCommands": {
        "CLANG_TRIPLE": "aarch64-linux-gnu-"
      }
    },
    "AnyKernel3": {
      "use": false,
      "release": true
    },
    "enableKernelSU": false,
    "enableLXC": false,
    "enableBBG": false
  }
]
