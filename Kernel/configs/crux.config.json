[
  {
    "kernelSource": {
      "name": "crux-marisa",
      "repo": "https://github.com/diudiuyc5200/0723.git",
      "branch": "ceshi",
      "device": "crux",
      "defconfig": "crux_defconfig"
    },
    "toolchains": [
      {
        "name": "proton-clang",
        "repo": "https://gitlab.com/LeCmnGend/proton-clang.git",
        "branch": "clang-16",
        "binaryEnv": ["bin"]
      }
    ],
    "enableCcache": true,
    "params": {
      "ARCH": "arm64",
      "CC": "proton-clang/bin/clang",
      "externalCommands": {
        "CROSS_COMPILE": "proton-clang/bin/aarch64-linux-gnu-",
        "CROSS_COMPILE_ARM32": "proton-clang/bin/arm-linux-gnueabi-",
        "CLANG_TRIPLE": "aarch64-linux-gnu-"
      }
    },
    "AnyKernel3": {
      "use": false,
      "release": true
    },
    "enableKernelSU": false,
    "enableLXC": false,
    "enableBBG": false
  }
]
